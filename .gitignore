# Julia
*.jl.cov
*.jl.*.cov
*.jl.mem
deps/deps.jl
deps/build.log
deps/downloads/
deps/usr/
deps/src/
docs/build/
docs/site/
docs/Manifest.toml

# Manifest.toml in sub-packages is environment-specific and should not be
# committed: the example sub-packages depend on the framework via Pkg.develop,
# and the user resolves their own.
examples/*/Manifest.toml

# The TOP-LEVEL Manifest.toml IS committed for now, because R3D is an
# unregistered GitHub-hosted dependency: the URL+commit lives in the
# Manifest, not the Project. Once R3D is registered in the General
# registry this can be uncommitted.

# Generated by examples/lagrangian_pixelization
examples/lagrangian_pixelization/frames/

# Editors and OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~
\#*\#
.#*

# REPL history etc
.julia_history

# Coverage
coverage/
lcov.info

# Logs
*.log

# Benchmark results: ignored by default; committed baselines are
# allow-listed by hostname pattern so users' ad-hoc local runs don't
# get accidentally committed.
benchmarks/results/*.json
!benchmarks/results/apple-silicon-*.json
!benchmarks/results/amd-*.json
benchmarks/Manifest.toml
